# ===================================
# PR Review Agent - Environment Configuration
# ===================================

# LLM Provider: openai, gemini, anthropic, or mock
DEFAULT_PROVIDER=openai

# Model configuration
DEFAULT_MODEL=gpt-4o-mini

# API Keys (Provide the one corresponding to your provider)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # or local Ollama: http://localhost:11434/v1

GEMINI_API_KEY=your_gemini_api_key_here

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Token (Optional for public repo diffs, required for private repos or posting comments)
GITHUB_TOKEN=your_github_personal_access_token_here
